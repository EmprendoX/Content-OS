# ---------------------------------------------------------------------------
# Content OS — variables de entorno
# Copia este archivo a .env.local y ajusta lo que necesites.
# La aplicación funciona sin configurar nada: usa SQLite local y MockProvider.
# ---------------------------------------------------------------------------

# Ruta de la base de datos SQLite (relativa a la raíz del proyecto)
DATABASE_PATH=./data/content-os.db

# Carpeta donde se guardan los archivos multimedia
MEDIA_DIR=./data/media

# Proveedor de IA por defecto: mock | anthropic | openai | ollama
# Puede cambiarse desde Configuración sin reiniciar.
LLM_PROVIDER=mock

# Claves de proveedores (solo se leen del entorno, nunca se guardan en la BD)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Clave de cifrado para tokens sociales (AES-256-GCM), 64 caracteres hexadecimales.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se deja vacía, se genera automáticamente en ./data/.encryption-key
CONTENT_OS_ENCRYPTION_KEY=

# Interruptor global de publicaciones al arrancar (true | false).
# Puede cambiarse desde Configuración. Por seguridad arranca desactivado.
PUBLISHING_ENABLED=false
